<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_notification"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_notification_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RGamer">
        <activity
            android:name=".withdraws.RewardHistory"
            android:exported="false"
            android:theme="@style/Theme.RGamer" /> <!-- ✅ KEEP ONLY ONE AdMob ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config"
            tools:replace="android:resource" />

        <!-- FCM DEFAULT NOTIFICATION METADATA -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="earning_notifications" />

        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service> <!-- Activities -->
        <activity
            android:name=".Game.JoinedPlayersActivity"
            android:exported="false" />
        <activity
            android:name=".lucky_draw.activity_daily_spin"
            android:exported="false" />
        <activity
            android:name=".lucky_draw.QuizActivity"
            android:exported="false" />
        <activity
            android:name=".lucky_draw.activity_lucky_draw_winner"
            android:exported="false" />
        <activity
            android:name=".Game.activity_winners"
            android:exported="false" />
        <activity
            android:name=".withdraws.activity_withdraw_success"
            android:exported="false" />
        <activity
            android:name=".withdraws.TransactionHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".invite.activity_refer_earn"
            android:exported="false" />
        <activity
            android:name=".lucky_draw.activity_lucky_draw"
            android:exported="false" />
        <activity
            android:name=".Game.TournamentActivity"
            android:exported="false" />
        <activity
            android:name=".Activitys.activity_login"
            android:exported="false" />
        <activity
            android:name=".Activitys.OnBoardingActivity"
            android:exported="false" />
        <activity
            android:name=".Activitys.MainActivity"
            android:exported="false" /> <!-- Launcher Activity -->
        <activity
            android:name=".Activitys.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- File Provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".Activitys.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".lucky_draw.ScratchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".lucky_draw.WatchVideoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".lucky_draw.HitRewardzActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NetworkIssueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity_delete_account"
            android:exported="false"
            android:theme="@style/Theme.RGamer"
            android:windowSoftInputMode="adjustResize" />

        <!-- Share & Earn Module Activities -->
        <activity
            android:name=".share_earn.ui.ShareEarnActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".share_earn.ui.OfferDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".share_earn.ui.OfferHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".share_earn.ui.ShareEarnEarningsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>