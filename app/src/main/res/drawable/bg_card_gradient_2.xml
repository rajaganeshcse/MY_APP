<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#b6edc8">

    <!-- Mask (controls ripple shape) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="20dp"/>
            <solid android:color="#b6edc8"/>
        </shape>
    </item>

    <!-- Content (your gradient background) -->
    <item>
        <shape android:shape="rectangle">

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#d397fa"
                android:endColor="#8364e8" />
            <corners android:radius="20dp" />

        </shape>
    </item>

</ripple>
