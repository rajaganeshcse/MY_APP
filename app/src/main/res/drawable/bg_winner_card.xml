<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_winner_card.xml — Card background for winner highlight cards.

    BUG FIX 1: Removed conflicting <solid> (solid + gradient = undefined behavior).
    BUG FIX 2: Changed angle from 20 (INVALID — must be multiples of 45) to 45.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#2A2340"
        android:endColor="#1A1535"
        android:angle="135" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="#4A3F8F" />
</shape>