<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#F5F5F5"/>

    <!-- Rounded corners -->
    <corners android:radius="8dp"/>

    <!-- Dashed border -->
    <stroke
        android:width="2dp"
        android:color="#6A1BFF"
        android:dashWidth="6dp"
        android:dashGap="4dp"/>

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp"/>
</shape>
