<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_hold_progress_drawable.xml — Progress bar drawable for Daily Bonus Hold-to-Claim button.
    Deep translucent track + vibrant gold-to-orange gradient fill.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#2A1B54" />
            <stroke
                android:width="1dp"
                android:color="#4C1D95" />
        </shape>
    </item>
    <!-- Progress Fill with rich Gold-to-Orange Gradient -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="24dp" />
                <gradient
                    android:startColor="#FFD700"
                    android:centerColor="#F59E0B"
                    android:endColor="#FF5E00"
                    android:angle="0" />
            </shape>
        </clip>
    </item>
</layer-list>
