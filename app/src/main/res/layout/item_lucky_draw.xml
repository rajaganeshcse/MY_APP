<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLuckyDrawRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EEF2FF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================
             TOP ROW: REWARD COINS & JOINED STATUS BADGE
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- LEFT: REWARD BADGE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_reward_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="Reward Coins" />

                <TextView
                    android:id="@+id/txtReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Win 1000 Coins 🎉"
                    android:textColor="#92400E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SPACER -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- RIGHT: JOINED STATUS BADGE -->
            <LinearLayout
                android:id="@+id/joined"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_joined_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓ 2 Joined"
                    android:textColor="#047857"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================
             SLOT STATUS & PERCENTAGE BADGE
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filled: 56 / 150 Slots"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- PERCENT FILL CHIP -->
            <TextView
                android:id="@+id/txtPercent"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_percent_chip"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="62% Filled"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4338CA" />

        </LinearLayout>

        <!-- ============================================================
             CUSTOM PROGRESS BAR
             ============================================================ -->
        <ProgressBar
            android:id="@+id/progressSlots"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="62"
            android:progressDrawable="@drawable/bg_slot_progress" />

        <!-- ============================================================
             ACTION BUTTONS ROW
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- TICKET ENTRY BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnticketEntry"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="🎟️ Tickets"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#4F46E5"
                app:cornerRadius="12dp"
                app:elevation="2dp" />

            <!-- FREE ENTRY BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFreeEntry"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="📺 Free Entry"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#10B981"
                app:cornerRadius="12dp"
                app:elevation="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>