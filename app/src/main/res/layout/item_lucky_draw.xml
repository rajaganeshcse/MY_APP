<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLuckyDrawRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/color_yellow"
    android:backgroundTint="@color/color_yellow"
    android:background="#C8BC62">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:backgroundTint="#B9E4E2"
        android:background="#E6D87D"
        android:orientation="vertical">

        <!-- TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Win 100"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <ImageView
                android:id="@+id/imgCoin"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/txtDrawId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1122734"
                android:textSize="12sp"
                android:textColor="#AAAAAA"
                android:visibility="invisible"/>
        </LinearLayout>

        <!-- STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtSlots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Left : 56/150"
                android:textSize="13sp"
                android:textColor="#666666" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/txtPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="62% Filled"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#009688" />
        </LinearLayout>

        <!-- PROGRESS -->
        <ProgressBar
            android:id="@+id/progressSlots"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="62"
            android:progressTint="#009688"
            android:backgroundTint="#E0E0E0"/>

        <!-- BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnticketEntry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2 Tickects"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#000000"
                app:cornerRadius="10dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFreeEntry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Get Free Entry"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#6A1BFF"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
