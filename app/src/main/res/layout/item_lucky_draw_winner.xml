<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EEF2FF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================
             1. TOP ROW: REWARD COINS & DRAW STATUS BADGE
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- REWARD CHIP -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_reward_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="Reward Coins" />

                <TextView
                    android:id="@+id/txtReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="1000 Coins"
                    android:textColor="#92400E"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- STATUS BADGE -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_status_success"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="COMPLETED"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

        </LinearLayout>

        <!-- ============================================================
             2. WINNER NAME ROW
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtWinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Winner: Loading..."
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ============================================================
             3. WINNING TOKEN CHIP
             ============================================================ -->
        <LinearLayout
            android:id="@+id/layoutTokenContainer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_token_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ticket"

                android:contentDescription="Token Icon" />

            <TextView
                android:id="@+id/txtWinningToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Token: A7K2P"
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:typeface="monospace" />

        </LinearLayout>

        <!-- ============================================================
             4. DATE & TIME STAMP
             ============================================================ -->
        <TextView
            android:id="@+id/txtCompletedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="📅 Completed at: 20 Sep 2026, 01:05 PM"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>