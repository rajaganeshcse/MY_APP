<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp"
    android:backgroundTint="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_winner_card">

        <!-- 🔥 TOP ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- LEFT: Reward -->
            <TextView
                android:id="@+id/txtReward"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏆 0 Coins"
                android:textColor="#FF9800"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- RIGHT: Status -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_success"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="COMPLETED"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 👤 Winner -->
        <TextView
            android:id="@+id/txtWinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Winner UID: xxxx"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="8dp"/>

        <!-- 📅 Time -->
        <TextView
            android:id="@+id/txtCompletedAt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed at: 26 Dec 2025 12:55 AM"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>