<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#CBD5E1" />

    <!-- Offer & Reward Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgClaimLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/txtClaimTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Claim Your Reward"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtClaimRewardCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+2,800 Coins"
            android:textColor="#16A34A"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Instruction Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#F1F5F9"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Required"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtClaimInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter your registered mobile number or UPI reference ID from your transaction so we can verify and credit your coins."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReferralCodeReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Referral Code Used: None"
            android:textColor="#4F46E5"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Proof Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblProofInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proof Details *"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editClaimProof"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#F8FAFC"
            android:hint="e.g. 9876543210 or UPI Ref 123456789"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtClaimError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBarClaim"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:indeterminateTint="#4F46E5"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnSubmitClaim"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4F46E5"
        android:text="Submit Claim for Verification"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

    <Button
        android:id="@+id/btnCancelClaim"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#64748B"
        android:textSize="14sp" />

</LinearLayout>
