<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_invite"
    android:layout_width="match_parent"
    android:layout_height="157dp"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="@drawable/bg_card_gradient_1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LEFT CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Invite Friends"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- MATERIAL BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInviteNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="INVITE NOW"
                android:clickable="false"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_gravity="center"
                android:background="@drawable/bg_button_ripple"
                app:backgroundTint="@null"
                app:rippleColor="@null"
                android:paddingHorizontal="22dp"
                android:paddingVertical="10dp"/>

        </LinearLayout>

        <!-- IMAGE RIGHT -->
        <ImageView
            android:layout_width="152dp"
            android:layout_height="132dp"
            android:src="@drawable/ic_invite"
            android:contentDescription="Invite Friends"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
