<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHitRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP HIGH PAYOUT RIBBON BANNER -->
        <TextView
            android:id="@+id/badgeHitzRibbon"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/bg_hitz_ribbon_light"
            android:gravity="center"
            android:text="⚡ HIGH PAYOUT LONG AD OFFER ⚡"
            android:textColor="#4338CA"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <!-- ICON BADGE CONTAINER -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_hitz_icon_light">

                <ImageView
                    android:id="@+id/imgHitzIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lightning"
                    app:tint="#D97706"
                    android:contentDescription="Hitz Icon" />
            </FrameLayout>

            <!-- TITLE & REWARD BADGES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/txtHitzTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mega Hitz Offer #1"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <!-- REWARD & DURATION ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- COIN PAYOUT CHIP -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="24dp"
                        android:background="@drawable/bg_hitz_coin_chip_light"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_coin"
                            android:contentDescription="Coins" />

                        <TextView
                            android:id="@+id/txtHitzRewardCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="+10 Coins"
                            android:textColor="#B45309"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:ellipsize="none" />
                    </LinearLayout>

                    <!-- TICKET REWARD CHIP -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="24dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_hitz_duration_chip_light"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_ticket"
                            android:contentDescription="Tickets" />

                        <TextView
                            android:id="@+id/txtHitzRewardTickets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="+5 Tickets"
                            android:textColor="#15803D"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:maxLines="1"
                            android:ellipsize="none" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- WATCH LONG AD BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchHitzItem"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="92dp"
                android:text="WATCH AD ⚡"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_quiz_watch_ad"
                app:backgroundTint="@null"
                app:cornerRadius="14dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
