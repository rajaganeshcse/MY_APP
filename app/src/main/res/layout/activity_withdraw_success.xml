<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 🔹 TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="84dp"
            android:layout_height="66dp"
            android:contentDescription="Back"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_width="198dp"
            android:layout_height="66dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Status"
            android:textColor="@color/black"
            android:textSize="35sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 🔹 CONTENT (CENTERED) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="0dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="10dp"
        android:paddingTop="5dp">

        <!-- SUCCESS IMAGE -->

        <!-- TITLE -->

        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="259dp"
            android:layout_height="254dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Success"
            android:src="@drawable/ic_success" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Success"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/color_green"
            android:layout_marginBottom="8dp" />

        <!-- MESSAGE -->
        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your request is being processed"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- REWARD TYPE -->
        <TextView
            android:id="@+id/txtRewardType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Reward: Google Play Voucher"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- AMOUNT -->
        <TextView
            android:id="@+id/txtAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="₹0"
            android:textColor="#6A1BFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <!-- VOUCHER CODE -->
        <TextView
            android:id="@+id/txtVoucherCode"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_voucher_code"
            android:padding="10dp"
            android:text="CODE: XXXX-XXXX-XXXX"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- DONE BUTTON -->
        <TextView
            android:id="@+id/btnDone"
            android:layout_width="317dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_button_ripple"
            android:gravity="center"
            android:padding="14dp"
            android:text="DONE"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
