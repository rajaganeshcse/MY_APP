<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/base_color">

    <!-- 🔹 TOP BAR -->
    <LinearLayout
        android:paddingTop="20sp"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="282dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Status"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- 🔹 CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgSuccess"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="60dp"
            android:src="@drawable/ic_processing" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="47dp"
            android:layout_marginTop="12dp"
            android:text="Processing"
            android:gravity="center_horizontal"
            android:textColor="@color/color_green"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginBottom="10dp"
            android:text="Please wait while we process your request"
            android:textColor="@color/black"
            android:gravity="center_horizontal"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/txtRewardType"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginBottom="8dp"
            android:text="Reward"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- METHOD + AMOUNT -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgMethod"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/wallet_icon" />

            <TextView
                android:id="@+id/txtAmount"
                android:text="₹0"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#6A1BFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <!-- DATE & TIME -->
        <TextView
            android:id="@+id/txtDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01 May 2026, 10:09 AM"
            android:textSize="14sp"
            android:textColor="#777"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:gravity="center"/>

        <!-- VOUCHER CODE -->
        <TextView
            android:id="@+id/txtVoucherCode"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="25dp"
            android:background="@drawable/bg_voucher_code"
            android:text="CODE: XXXX-XXXX-XXXX"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="14dp"
            android:visibility="gone" />

        <!-- UPI / BANK DETAILS -->
        <TextView
            android:id="@+id/txtdetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:background="@drawable/bg_light_border"
            android:gravity="center"
            android:layout_marginBottom="30dp"
            android:visibility="gone" />

        <!-- DONE -->
        <TextView
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:padding="15dp"
            android:layout_marginTop="20sp"
            android:textSize="20sp"
            android:text="DONE"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>
</LinearLayout>
