<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:orientation="vertical">

    <!-- ============================================================
         HEADER BAR
         ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- BACK BUTTON -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_back_light"
            android:clickable="true"
            android:contentDescription="Back"
            android:elevation="4dp"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/back_arrow"
            app:tint="#0F172A" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="Transaction Status"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- BALANCE SPACER -->
        <View
            android:layout_width="42dp"
            android:layout_height="42dp" />

    </LinearLayout>

    <!-- ============================================================
         MAIN CONTENT SCROLL CONTAINER
         ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- MAIN STATUS CARD CONTAINER -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardPreventCornerOverlap="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- STATUS BADGE ANIMATION / ICON -->
                    <ImageView
                        android:id="@+id/imgSuccess"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="Status Icon"
                        android:src="@drawable/ic_processing" />

                    <!-- STATUS TITLE -->
                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:letterSpacing="0.01"
                        android:text="Processing ⏳"
                        android:textColor="#D97706"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- STATUS MESSAGE SUBTITLE -->
                    <TextView
                        android:id="@+id/txtMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Please wait while we process your request"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <!-- RECEIPT / PAYOUT DETAILS CONTAINER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_edit_text_light"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- PAYOUT METHOD BADGE & TITLE -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgMethod"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="Method Icon"
                                android:src="@drawable/wallet_icon" />

                            <TextView
                                android:id="@+id/txtRewardType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reward: Voucher"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- AMOUNT -->
                        <TextView
                            android:id="@+id/txtAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="₹0"
                            android:textColor="#4F46E5"
                            android:textSize="32sp"
                            android:textStyle="bold" />

                        <!-- DATE & TIME -->
                        <TextView
                            android:id="@+id/txtDateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="01 May 2026, 10:09 AM"
                            android:textColor="#64748B"
                            android:textSize="12sp" />

                        <!-- VOUCHER CODE (COPYABLE BADGE WITH COPY ICON) -->
                        <LinearLayout
                            android:id="@+id/containerVoucherBadge"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_voucher_code"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtVoucherCode"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:letterSpacing="0.02"
                                android:text="CODE: XXXX-XXXX-XXXX"
                                android:textColor="#4F46E5"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/imgCopyIcon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="Copy Voucher Code"
                                android:src="@drawable/ic_copy"
                                app:tint="#4F46E5" />

                        </LinearLayout>

                        <!-- UPI / BANK DETAILS -->
                        <TextView
                            android:id="@+id/txtdetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="#FFFFFF"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:text="Details"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- DONE BUTTON -->
                    <TextView
                        android:id="@+id/btnDone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_btn_primary_gradient"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:letterSpacing="0.02"
                        android:text="DONE"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- ADVERTISEMENT BANNER AT BOTTOM -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="ADVERTISEMENT"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:letterSpacing="0.08" />

                    <com.google.android.gms.ads.AdView
                        android:id="@+id/adViewSuccess"
                        xmlns:ads="http://schemas.android.com/apk/res-auto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_gravity="center"
                        ads:adSize="BANNER"
                        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
