<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_rowWeight="1"
    android:layout_columnWeight="1"
    android:layout_margin="8dp"
    android:background="@drawable/bg_login_card_glass"
    android:elevation="6dp"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Option Icon -->
    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="Payout Icon"
        android:src="@drawable/ic_google_play" />

    <!-- Coin Icon + Cost -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="Coin Icon"
            android:src="@drawable/ic_coin" />

        <TextView
            android:id="@+id/txtCoinCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1000"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Rupee Amount -->
    <TextView
        android:id="@+id/txtAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="₹10"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle / Method Detail -->
    <TextView
        android:id="@+id/methoddetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Voucher Code"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

</LinearLayout>
