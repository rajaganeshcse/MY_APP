<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/card_task"
    android:layout_width="150dp"
    android:layout_height="184dp"

    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="12dp"

    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="@drawable/bg_card_gradient_1"

        android:orientation="vertical"
        android:gravity="center_horizontal"

        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:text="Complete Tasks"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- TASK IMAGE -->
        <ImageView
            android:id="@+id/ic_tasks"

            android:layout_width="82dp"
            android:layout_height="85dp"

            android:layout_marginTop="2dp"

            android:contentDescription="Complete Tasks"
            android:scaleType="centerInside"
            android:src="@drawable/ic_tasks" />

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTaskNow"

            android:layout_width="wrap_content"
            android:layout_height="38dp"

            android:layout_marginTop="4dp"

            android:background="@drawable/bg_button_ripple"

            android:clickable="false"

            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"

            android:text="Start Task"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"

            app:backgroundTint="@null"
            app:rippleColor="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>