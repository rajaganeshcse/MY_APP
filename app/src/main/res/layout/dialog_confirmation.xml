<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="16dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================================================
             1. HEADER (64dp, SUBTLE GRADIENT #4F46E5 -> #7C3AED)
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_dialog_header"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_ticket"
                android:contentDescription="Ticket Icon" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Ticket Entry"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- Close Button (Circular Translucent #25FFFFFF) -->
            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/close"
                app:tint="#FFFFFF"
                android:background="@drawable/bg_close_button"
                android:contentDescription="Close"
                android:focusable="true"
                android:clickable="true" />

        </LinearLayout>

        <!-- ============================================================
             2. BODY CONTENT (BACKGROUND #F8FAFC)
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Main Title -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Join Lucky Draw"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/Message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select the number of tickets you want to enter"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- ============================================================
                 3. QUANTITY CARD CONTAINER (#FFFFFF, 18dp radius)
                 ============================================================ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutQuantityContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT TICKETS"
                        android:textColor="#4F46E5"
                        android:textSize="11sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <!-- Stepper Control Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Minus Button (48dp x 48dp) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnMinus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#EEF2FF"
                            app:cardElevation="0dp"
                            app:strokeColor="#C7D2FE"
                            app:strokeWidth="1dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="−"
                                android:textColor="#4F46E5"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Quantity Display (30sp Bold #4F46E5) -->
                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1"
                                android:textColor="#4F46E5"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_ticket"

                                android:contentDescription="Ticket" />

                        </LinearLayout>

                        <!-- Plus Button (48dp x 48dp) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnPlus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="14dp"
                            app:cardBackgroundColor="#4F46E5"
                            app:cardElevation="2dp"
                            app:strokeWidth="0dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="+"
                                android:textColor="#FFFFFF"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- MAX Button Chip -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnMax"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="14dp"
                            app:cardCornerRadius="10dp"
                            app:cardBackgroundColor="#EEF2FF"
                            app:cardElevation="0dp"
                            app:strokeColor="#C7D2FE"
                            app:strokeWidth="1dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="MAX"
                                android:textColor="#4F46E5"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Ticket Balance & Slot Availability -->
                    <TextView
                        android:id="@+id/txtTicketBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Available: 10 Tickets  •  24 Slots Left"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:gravity="center" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================================
                 4. BOTTOM ACTION BUTTONS
                 ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <!-- Cancel Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#475569"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="#F1F5F9"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <!-- Confirm Button (Primary Action) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.3"
                    android:layout_marginStart="4dp"
                    android:text="JOIN DRAW · 1"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="#4F46E5"
                    app:cornerRadius="14dp"
                    app:elevation="3dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>