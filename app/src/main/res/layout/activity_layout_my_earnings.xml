<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_history"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="71dp"
            android:layout_height="wrap_content"
            android:text="Claim"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Referral Coins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_reward_card"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtCoins"
            android:layout_width="60dp"
            android:layout_height="58dp"
            android:textColor="@color/black"
            android:text="0"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="163dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/black"
            android:text="Referral Coins" />
    </LinearLayout>

    <!-- Referral Tickets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_history"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTickets"
            android:layout_width="55dp"
            android:layout_height="81dp"
            android:text="0"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="188dp"
            android:layout_height="57dp"
            android:textColor="@color/black"
            android:layout_marginTop="8dp"
            android:text="Referral Tickets" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClaim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Claim Reward"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6A1BFF"
        android:layout_marginTop="20dp" />

</LinearLayout>
