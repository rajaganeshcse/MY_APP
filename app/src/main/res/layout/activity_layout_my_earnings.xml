<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base_color"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_history"
        android:gravity="center_horizontal"
        android:padding="16dp"
        android:paddingBottom="25dp"
        >

        <TextView
            android:layout_width="166dp"
            android:layout_height="wrap_content"

            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="Claim  🎉"
            android:textColor="@color/black"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Referral Coins -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_reward_card"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtCoins"
            android:layout_width="53dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:text="0"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="163dp"
            android:layout_height="35dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:text="Referral Coins" />
    </LinearLayout>

    <!-- Referral Tickets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_history"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTickets"
            android:layout_width="56dp"
            android:layout_height="51dp"
            android:layout_gravity="center_vertical"
            android:text="0"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="188dp"
            android:layout_height="57dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:layout_marginTop="8dp"
            android:text="Referral Tickets" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClaim"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Claim Reward"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6A1BFF"
        android:layout_marginTop="20dp" />

</LinearLayout>
