<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 Claim Rewards"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Collect your referral rewards"
                    android:textSize="15sp"
                    android:textColor="#888888"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Coins Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="25dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFE082"
            app:cardBackgroundColor="#FFFDF5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="22dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_yellow"
                    android:padding="18dp"
                    android:src="@drawable/ic_coin"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Referral Coins"
                        android:textStyle="bold"
                        android:textSize="23sp"
                        android:textColor="#FF9800"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Balance"
                        android:textColor="#777777"
                        android:textSize="14sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F57C00"
                    android:textStyle="bold"
                    android:textSize="34sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Tickets Card -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="#90CAF9"
            app:cardBackgroundColor="#F7FBFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="22dp">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/circle_blue"
                    android:padding="18dp"
                    android:src="@drawable/ic_ticket"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Referral Tickets"
                        android:textStyle="bold"
                        android:textSize="23sp"
                        android:textColor="#1976D2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Balance"
                        android:textColor="#777777"
                        android:textSize="14sp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtTickets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:textSize="34sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Claim Button -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaim"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="35dp"
            android:text="🎉 CLAIM REWARD"
            android:textAllCaps="false"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:rippleColor="@color/Primary"
            android:background="@drawable/bg_btn_primary"
            app:cornerRadius="32dp"
            app:elevation="8dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>