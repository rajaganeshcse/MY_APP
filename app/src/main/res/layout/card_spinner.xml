<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/card_spinner"
    android:layout_width="150dp"
    android:layout_height="184dp"

    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="16dp"
    android:clickable="true"
    android:layout_marginBottom="12dp"

    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spin &amp; Win"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- SPINNER IMAGE -->
        <ImageView
            android:id="@+id/imgSpinner"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:contentDescription="Spinner"
            android:scaleType="centerInside"
            android:src="@drawable/ic_spinner" />

        <!-- SPIN BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpinNow"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"

            android:text="SPIN NOW"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="false"

            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"

            android:background="@drawable/bg_button_ripple"
            app:backgroundTint="@null"
            app:rippleColor="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>