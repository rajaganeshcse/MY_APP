<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <!-- ============================================================
         BACKGROUND DECORATIVE GLOW ELEMENTS
         ============================================================ -->
    <View
        android:id="@+id/glowCircleTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.25"
        android:background="@drawable/bg_glow_circle"
        android:translationX="100dp"
        android:translationY="-80dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true" />

    <View
        android:id="@+id/glowCircleBottom"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="-150dp"
        android:alpha="0.18"
        android:background="@drawable/bg_glow_circle"
        android:translationX="-120dp"
        android:translationY="60dp" />

    <!-- ============================================================
         DECORATIVE FLOATING BACKGROUND COINS (2 COINS)
         ============================================================ -->
    <ImageView
        android:id="@+id/floatingCoin1"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="28dp"
        android:layout_marginTop="55dp"
        android:alpha="0.90"
        android:elevation="6dp"
        android:contentDescription="Floating Coin 1"
        android:src="@drawable/ic_coin" />

    <ImageView
        android:id="@+id/floatingCoin2"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="140dp"
        android:alpha="0.85"
        android:elevation="6dp"
        android:contentDescription="Floating Coin 2"
        android:src="@drawable/ic_coin" />

    <!-- ============================================================
         HERO & BRANDING CONTAINER (PERFECTLY CENTERED IN UPPER MIDDLE)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/heroContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_sheet"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Curved Corner Container for App Logo -->
        <androidx.cardview.widget.CardView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardPreventCornerOverlap="false">

            <!-- App Logo with Curved Radius -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />

        </androidx.cardview.widget.CardView>

        <!-- App Name (Deep Slate Navy) -->
        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textColor="#0F172A"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- App Description / Tagline (Slate Grey) -->
        <TextView
            android:id="@+id/heroSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/app_description"
            android:textColor="#475569"
            android:textSize="15sp" />

        <!-- Feature Badges Chip Bar -->
        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_chip"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="🎮 Play Games"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_login_chip"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="💎 Free Credits"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_login_chip"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="🏆 Offers"
                android:textColor="#1E293B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================
         BOTTOM SHEET CONTAINER (PURE WHITE LOGIN CARD)
         ============================================================ -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_login_card_glass"
        android:elevation="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- Welcome Title -->
        <TextView
            android:id="@+id/txtWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="@string/app_name1"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtext -->
        <TextView
            android:id="@+id/txtWelcomeSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Sign in to access your rewards, coins &amp; wallet"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Google Login Button Container -->
        <LinearLayout
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_login_google_btn"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/imgGoogle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Google Sign In"
                android:src="@drawable/ic_google" />

            <TextView
                android:id="@+id/txtGoogle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Continue with Google"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/loginProgressBar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateTint="#4F46E5"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Guarantee / Security Line -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡ Fast Login  •  🔒 100% Safe &amp; Encrypted"
                android:textColor="#64748B"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Privacy Policy Link -->
        <TextView
            android:id="@+id/txtPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="Privacy Policy &amp; Terms of Service"
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
