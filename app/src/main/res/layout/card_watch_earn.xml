<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_watch_earn"
    android:layout_width="match_parent"
    android:layout_height="157dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    android:layout_marginLeft="12dp"
    android:clickable="true"
    android:focusable="true"
    android:layout_marginRight="12dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_card_gradient"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LEFT CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Watch and Earn"
                android:textColor="@color/black"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- WATCH BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:text="Watch Now"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_button_ripple"
                app:backgroundTint="@null"
                app:rippleColor="@null"
                android:paddingHorizontal="22dp"
                android:paddingVertical="10dp"/>

            <!-- ✅ ADS COUNTER (FIX) -->
            <TextView
                android:id="@+id/txtAdCount"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="0/20 ads watched"
                android:textSize="13sp"
                android:textColor="#444444"/>

        </LinearLayout>

        <!-- IMAGE RIGHT -->
        <ImageView
            android:layout_width="131dp"
            android:layout_height="107dp"
            android:src="@drawable/ic_watch"
            android:contentDescription="Watch and Earn"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
