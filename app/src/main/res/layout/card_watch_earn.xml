<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- ================= SCRATCH CARD ================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/card_watch"

        android:layout_width="150dp"
        android:layout_height="184dp"

        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"

        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="@drawable/bg_card_gradient_2"

        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Watch and Earn"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold"

            android:gravity="center" />

        <!-- WATCH IMAGE -->
        <ImageView
            android:id="@+id/ic_watch"

            android:layout_width="82dp"
            android:layout_height="77dp"

            android:layout_marginTop="2dp"

            android:contentDescription="Watch and Earn"
            android:scaleType="centerInside"
            android:src="@drawable/ic_watch" />

        <!-- ADS COUNTER -->
        <TextView
            android:id="@+id/txtAdCount"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="2dp"

            android:text="0/20 ads watched"
            android:textColor="#444444"
            android:textSize="10sp"
            android:gravity="center" />

        <!-- WATCH BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatchNow"

            android:layout_width="104dp"
            android:layout_height="38dp"

            android:layout_marginTop="2dp"

            android:background="@drawable/bg_button_ripple"
            android:paddingStart="14dp"
            android:paddingTop="0dp"
            android:paddingEnd="14dp"

            android:paddingBottom="0dp"
            android:text="Watch Now"
            android:textColor="#000000"
            android:textSize="12sp"

            android:textStyle="bold"

            app:backgroundTint="@null"
            app:rippleColor="@null" />



    </LinearLayout>

</androidx.cardview.widget.CardView>
</LinearLayout>