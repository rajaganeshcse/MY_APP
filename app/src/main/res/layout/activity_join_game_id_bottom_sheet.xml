<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- GAME NAME -->
    <TextView
        android:id="@+id/txtGame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GAME NAME"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black" />

    <!-- GAME ID INPUT -->
    <EditText
        android:id="@+id/edtGameName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Enter Game ID"
        android:inputType="text"
        android:textColor="@color/black"
        android:textColorHint="#888" />

    <!-- NOTE -->
    <TextView
        android:id="@+id/txtNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="⚠️ Game ID will be saved and auto-used for future tournaments of this game."
        android:textSize="12sp"
        android:textColor="#666" />

    <!-- CONFIRM BUTTON -->
    <TextView
        android:id="@+id/btnConfirmJoin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="CONFIRM JOIN"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_btn_primary" />
</LinearLayout>
