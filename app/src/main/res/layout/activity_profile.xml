<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ================= TOP BAR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="30dp"
        android:paddingBottom="5dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="7dp"
            android:src="@drawable/back_arrow"
            android:background="@drawable/bg_back_button"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Profile"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EEF7"/>

    <!-- ================= PROFILE STRENGTH ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#F1FBF5"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile Strength"
                android:textColor="#171717"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtProfileStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_completed"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="100% COMPLETED"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/profileProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="#D7EADB"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/bule_color"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EEF7"/>

    <!-- ================= CONTENT ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- ================= FULL NAME ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#171717"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="8dp"
                    android:background="@drawable/bg_edittext">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="31dp"
                        android:contentDescription="Name"
                        android:src="@drawable/ic_person"
                        android:tint="@color/bule_color" />

                    <EditText
                        android:id="@+id/edtName"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="3dp"
                        android:singleLine="true"
                        android:textCursorDrawable="@color/color_blue"
                        android:hint="Full Name"
                        android:textColor="#555B63"
                        android:textSize="15sp"/>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_profile_circle"
                        android:contentDescription="Profile photo"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"/>

                    <ImageView
                        android:id="@+id/btnEditPhoto"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="bottom|end"
                        android:padding="3dp"
                        android:src="@drawable/ic_edit"
                        android:background="@drawable/bg_edit_circle"
                        android:contentDescription="Edit profile photo"/>
                </FrameLayout>
            </LinearLayout>

            <!-- ================= MOBILE ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mobile Number"
                android:textColor="#171717"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="94dp"
                    android:background="@drawable/bg_edittext_gray">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="29dp"
                        android:contentDescription="Mobile"
                        android:src="@drawable/ic_phone"
                        android:tint="@color/color_blue" />

                    <EditText
                        android:id="@+id/edtMobile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="center_vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="0dp"
                        android:hint="Enter 10-digit Mobile Number"
                        android:textColor="@color/black"
                        android:textCursorDrawable="@color/color_blue"
                        android:textColorHint="#777777"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:inputType="number"
                        android:maxLength="10"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtMobileVerified"
                    android:layout_width="78dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_verified"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="ⓘ Enter valid 10-digit mobile number"
                android:textColor="#777777"
                android:textStyle="bold"
                android:textSize="9sp"/>

            <!-- ================= EMAIL ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Email Id"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="14sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="11dp"
                    android:paddingEnd="94dp"
                    android:background="@drawable/bg_edittext_gray">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="30dp"
                        android:contentDescription="Email"
                        android:src="@drawable/ic_email"
                        android:tint="@color/color_blue" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:gravity="center_vertical"
                        android:inputType="textEmailAddress"
                        android:paddingStart="7dp"
                        android:paddingEnd="0dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEmailVerified"
                    android:layout_width="78dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_verified"
                    android:gravity="center"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="ⓘ Email cannot be changed"
                android:textColor="@color/color_red"
                android:textStyle="bold"
                android:textSize="9sp"/>

            <!-- ================= DOB ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Date of Birth"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/dateContainer"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="11dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_edittext">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="28dp"
                    android:contentDescription="Calendar"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/color_blue"/>

                <TextView
                    android:id="@+id/txtDob"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:hint="DD-MM-YYYY"
                    android:textColor="#555B63"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/imgDobChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="Open date picker"/>
            </LinearLayout>

            <!-- ================= GENDER ================= -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Gender"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="14sp"/>

            <LinearLayout
                android:id="@+id/genderContainer"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="11dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_edittext">

                <TextView
                    android:id="@+id/txtGenderSymbol"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="♂"
                    android:textColor="@color/color_blue"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtGender"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="Male"
                    android:textColor="#555B63"
                    android:textSize="14sp"/>

                <ImageView
                    android:id="@+id/imgGenderChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="Select gender"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ================= BOTTOM BUTTONS ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!-- SAVE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/bule_color"
            app:cornerRadius="10dp"
            app:rippleColor="#1976D2"
            app:strokeWidth="0dp"/>

        <!-- DELETE ACCOUNT LINK -->
        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:text="Delete Account"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>