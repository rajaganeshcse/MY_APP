<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="15dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="69dp"
            android:layout_height="46dp"
            android:contentDescription="Back"
            android:padding="7dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_width="104dp"
            android:layout_height="31dp"
            android:layout_marginStart="12dp"
            android:text="profile"
            android:textColor="#111111"
            android:textSize="25sp"
            android:textStyle="normal" />

    </LinearLayout>


    <!-- Profile Strength Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="18dp"
        android:paddingBottom="22dp"
        android:background="#F1FBF5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile Strength"
                android:textColor="#171717"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/txtProfileStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="100% COMPLETED"
                android:textColor="#16A34A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_completed" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/profileProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="18dp"
            android:max="100"
            android:progress="100"
            android:progressTint="#16A34A"
            android:backgroundTint="#D7EADB" />

    </LinearLayout>


    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="30dp"
            android:paddingBottom="10dp">


            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#171717"
                android:textStyle="bold"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="28dp"
                    android:paddingEnd="15dp"
                    android:gravity="center_vertical"
                    android:text="Rajaganesh"
                    android:textColor="#666666"
                    android:textSize="20sp"
                    android:singleLine="true"
                    android:background="@drawable/bg_edittext" />

                <!-- Profile Image -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="18dp">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:background="@drawable/bg_profile_circle"
                        android:padding="4dp" />

                    <ImageView
                        android:id="@+id/btnEditPhoto"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom|end"
                        android:padding="9dp"
                        android:src="@drawable/ic_edit"
                        android:background="@drawable/bg_edit_circle"
                        android:contentDescription="Edit profile photo" />

                </FrameLayout>

            </LinearLayout>


            <!-- Mobile Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Mobile Number"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/edtMobile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="28dp"
                    android:paddingEnd="150dp"
                    android:gravity="center_vertical"
                    android:text="6382641748"
                    android:textColor="#666666"
                    android:textSize="20sp"
                    android:singleLine="true"
                    android:inputType="phone"
                    android:enabled="false"
                    android:background="@drawable/bg_edittext_gray" />

                <TextView
                    android:id="@+id/txtMobileVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="15dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_verified" />

            </FrameLayout>

            <TextView
                android:layout_width="355dp"
                android:layout_height="21dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="ⓘ Mobile number cannot be changed"
                android:textColor="@color/color_red"
                android:textSize="16sp" />


            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textStyle="bold"
                android:text="Email Id"
                android:textColor="#171717"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp">

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="28dp"
                    android:paddingEnd="150dp"
                    android:gravity="center_vertical"
                    android:text="abcdefg@gmail.com"
                    android:textColor="#666666"
                    android:textSize="20sp"
                    android:singleLine="true"
                    android:inputType="textEmailAddress"
                    android:enabled="false"
                    android:background="@drawable/bg_edittext_gray" />

                <TextView
                    android:id="@+id/txtEmailVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="15dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_verified" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ⓘ Email Id cannot be changed"
                android:layout_gravity="center"
                android:textColor="@color/color_red"
                android:textSize="16sp" />


            <!-- Date of Birth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Date of Birth"
                android:textColor="#171717"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/dateContainer"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingEnd="20dp"
                android:background="@drawable/bg_edittext">

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Calendar" />

                <TextView
                    android:id="@+id/txtDob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:text="07-September-2025"
                    android:textColor="#555555"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Gender"
                android:textColor="#171717"
                android:textSize="22sp" />

            <RadioGroup
                android:id="@+id/radioGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="55dp"
                    android:text="Male"
                    android:textColor="#555555"
                    android:textSize="20sp"
                    android:buttonTint="@color/color_purple" />

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="55dp"
                    android:layout_marginStart="40dp"
                    android:text="Female"
                    android:textColor="#555555"
                    android:textSize="20sp"
                    android:buttonTint="@color/color_purple" />

            </RadioGroup>

        </LinearLayout>

    </ScrollView>


    <!-- Bottom Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Security Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp"
            android:background="#FFF9E9">

            <TextView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="⬟"
                android:textColor="#F57C00"
                android:textSize="27sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Don’t worry, Your data is safe with us. We never share personal details or spam you."
                android:textColor="#777777"
                android:textSize="17sp" />

        </LinearLayout>


        <!-- Save -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="28dp"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_save_button" />

        <!-- Delete Account -->
        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:text="Delete Account"
            android:textColor="@color/color_red"
            android:textSize="20sp" />

    </LinearLayout>

</LinearLayout>