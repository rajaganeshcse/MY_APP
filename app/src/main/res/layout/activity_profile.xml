<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="30dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="43dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical"
            android:padding="8dp"
            android:src="@drawable/back_arrow"
            android:background="@drawable/bg_back_button"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:text="Profile"
            android:textColor="#111111"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_vertical"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8EEF7"/>


    <!-- ================= PROFILE STRENGTH ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:background="#F1FBF5"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Profile Strength"
                android:textColor="#171717"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/txtProfileStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_completed"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="100% COMPLETED"
                android:textColor="#16A34A"
                android:textSize="10sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/profileProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="7dp"
            android:backgroundTint="#D7EADB"
            android:max="100"
            android:progress="100"
            android:progressTint="#16A34A"/>

    </LinearLayout>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">


            <!-- ================= FULL NAME ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textColor="#171717"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <!-- Name field with icon -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_edittext">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_person"
                    android:contentDescription="Name"
                    android:tint="#777777"/>

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="5dp"
                    android:gravity="center_vertical"
                    android:text="Hello User"
                    android:textColor="#555B63"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:background="@android:color/transparent"/>

                <!-- Profile photo -->

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="7dp">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:background="@drawable/bg_profile_circle"
                        android:padding="2dp"
                        android:contentDescription="Profile photo"/>

                    <ImageView
                        android:id="@+id/btnEditPhoto"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="bottom|end"
                        android:padding="5dp"
                        android:src="@drawable/ic_edit"
                        android:background="@drawable/bg_edit_circle"
                        android:contentDescription="Edit profile photo"/>

                </FrameLayout>

            </LinearLayout>


            <!-- ================= MOBILE ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mobile Number"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="15sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="105dp"
                    android:background="@drawable/bg_edittext_gray">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_phone"
                        android:contentDescription="Mobile"
                        android:tint="#777777"/>

                    <EditText
                        android:id="@+id/edtMobile"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingStart="9dp"
                        android:paddingEnd="0dp"
                        android:gravity="center_vertical"
                        android:text="00000000"
                        android:textColor="#666666"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="phone"
                        android:enabled="false"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtMobileVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_verified"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ⓘ Mobile number cannot be changed"
                android:textColor="@color/color_red"
                android:textSize="10sp"/>


            <!-- ================= EMAIL ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Email Id"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="15sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="105dp"
                    android:background="@drawable/bg_edittext_gray">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_email"
                        android:contentDescription="Email"
                        android:tint="#777777"/>

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:paddingStart="9dp"
                        android:paddingEnd="0dp"
                        android:gravity="center_vertical"
                        android:text="user1@gmail.com"
                        android:textColor="#666666"
                        android:textSize="15sp"
                        android:singleLine="true"
                        android:inputType="textEmailAddress"
                        android:enabled="false"
                        android:background="@android:color/transparent"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtEmailVerified"
                    android:layout_width="wrap_content"
                    android:layout_height="29dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="✓ Verified"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_verified"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ⓘ Email Id cannot be changed"
                android:textColor="@color/color_red"
                android:textSize="10sp"/>


            <!-- ================= DATE OF BIRTH ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Date of Birth"
                android:textColor="#171717"
                android:textSize="15sp"/>

            <LinearLayout
                android:id="@+id/dateContainer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_edittext"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_calendar"
                    android:contentDescription="Calendar"
                   />

                <TextView
                    android:id="@+id/txtDob"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="07-September-2025"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- ================= GENDER ================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Gender"
                android:textColor="#171717"
                android:textSize="15sp"/>

            <RadioGroup
                android:id="@+id/radioGender"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/color_violet"
                android:outlineSpotShadowColor="@color/color_violet"
                android:gravity="center_vertical">

                <RadioButton
                    android:id="@+id/radioMale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Male"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:buttonTint="@color/color_purple"/>

                <RadioButton
                    android:id="@+id/radioFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="18dp"
                    android:text="Female"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:buttonTint="@color/color_purple"/>

            </RadioGroup>

        </LinearLayout>

    </ScrollView>


    <!-- ================= BOTTOM ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Security Message -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:background="#FFF9E9">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="●"
                android:textColor="#F57C00"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Don't worry, your data is safe with us. We never share personal details or spam you."
                android:textColor="#777777"
                android:textSize="11sp"/>

        </LinearLayout>


        <!-- Save -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="9dp"
            android:text="Save Changes"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:paddingVertical="4dp"
            app:backgroundTint="@color/bule_color"
            app:cornerRadius="10dp"
            app:strokeWidth="0dp"
            app:rippleColor="#1976D2"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>


        <!-- Delete -->

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:layout_marginTop="1dp"
            android:text="Delete Account"
            android:textColor="@color/color_red"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</LinearLayout>