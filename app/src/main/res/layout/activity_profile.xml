<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- ============================================================
         BACKGROUND DECORATION GRADIENT & GLOW
         ============================================================ -->

    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scratch_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/glowCircle"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.25"
        android:background="@drawable/bg_glow_circle"
        android:translationX="70dp"
        android:translationY="-70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         MAIN WRAPPER CONTAINER
         ============================================================ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- ============================================================
             HEADER ROW (Matching Standard Scratch & Streak Header)
             ============================================================ -->

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="30dp"
            android:paddingBottom="10dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="13dp"
                android:src="@drawable/back_arrow"
                app:tint="#1E293B"
                android:background="@drawable/bg_delete_back"
                android:contentDescription="Back" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Profile"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your personal details"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================
             MAIN SCROLL CONTENT
             ============================================================ -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="20dp">

                <!-- =====================================================
                     HERO AVATAR CARD & PROFILE STRENGTH
                     ===================================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_chip_light"
                    android:elevation="3dp"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <!-- Profile Photo Avatar Frame -->
                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp">

                        <ImageView
                            android:id="@+id/imgProfile"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_profile_circle"
                            android:contentDescription="Profile Photo"
                            android:padding="3dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile" />

                        <!-- Floating Camera Edit Badge -->
                        <ImageView
                            android:id="@+id/btnEditPhoto"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom|end"
                            android:padding="5dp"
                            android:src="@drawable/ic_edit"
                            app:tint="#FFFFFF"
                            android:background="@drawable/bg_btn_claim_active"
                            android:elevation="4dp"
                            android:contentDescription="Edit Photo" />

                    </FrameLayout>

                    <!-- Strength Header Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Profile Strength"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProfileStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_completed"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:text="100% COMPLETED"
                            android:textColor="#047857"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Horizontal Progress Bar -->
                    <ProgressBar
                        android:id="@+id/profileProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/bule_color2" />

                </LinearLayout>

                <!-- =====================================================
                     PERSONAL DETAILS FORM CARD
                     ===================================================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_chip_light"
                    android:elevation="3dp"
                    android:padding="16dp">

                    <!-- FULL NAME -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="#475569"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_edittext">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Name Icon"
                            android:src="@drawable/ic_person"
                            app:tint="@color/bule_color2" />

                        <EditText
                            android:id="@+id/edtName"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:paddingStart="10dp"
                            android:paddingEnd="4dp"
                            android:singleLine="true"
                            android:hint="Full Name"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- MOBILE NUMBER -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile Number"
                        android:textColor="#475569"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="94dp"
                            android:background="@drawable/bg_edittext">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Mobile Icon"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/bule_color2" />

                            <EditText
                                android:id="@+id/edtMobile"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:paddingStart="10dp"
                                android:paddingEnd="0dp"
                                android:hint="10-digit Mobile Number"
                                android:textColor="#0F172A"
                                android:textColorHint="#94A3B8"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:inputType="number"
                                android:maxLength="10" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtMobileVerified"
                            android:layout_width="78dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_verified"
                            android:gravity="center"
                            android:text="✓ Verified"
                            android:textColor="#16A34A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:text="ⓘ Enter valid 10-digit mobile number"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <!-- EMAIL ID -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Id"
                        android:textColor="#475569"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="94dp"
                            android:background="@drawable/bg_edittext_gray">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Email Icon"
                                android:src="@drawable/ic_email"
                                app:tint="@color/bule_color2" />

                            <EditText
                                android:id="@+id/edtEmail"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:gravity="center_vertical"
                                android:inputType="textEmailAddress"
                                android:paddingStart="10dp"
                                android:paddingEnd="0dp"
                                android:singleLine="true"
                                android:textColor="#64748B"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtEmailVerified"
                            android:layout_width="78dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_verified"
                            android:gravity="center"
                            android:text="✓ Verified"
                            android:textColor="#16A34A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:text="ⓘ Email address is linked to your account"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <!-- DATE OF BIRTH -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth"
                        android:textColor="#475569"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/dateContainer"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="14dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_edittext">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Calendar Icon"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/bule_color2" />

                        <TextView
                            android:id="@+id/txtDob"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="DD-MM-YYYY"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/imgDobChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B"
                            android:contentDescription="Open date picker" />
                    </LinearLayout>

                    <!-- GENDER -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender"
                        android:textColor="#475569"
                        android:textStyle="bold"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/genderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_edittext">

                        <TextView
                            android:id="@+id/txtGenderSymbol"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="♂"
                            android:textColor="@color/bule_color2"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtGender"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Male"
                            android:textColor="#0F172A"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/imgGenderChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#64748B"
                            android:contentDescription="Select gender" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ============================================================
             BOTTOM ACTION BUTTONS
             ============================================================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- SAVE BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Save Changes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.03"
                android:textAllCaps="false"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/bule_color2"
                app:rippleColor="#40FFFFFF"
                app:elevation="6dp" />

            <!-- DELETE ACCOUNT LINK -->
            <TextView
                android:id="@+id/btnDelete"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:text="Delete Account"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>