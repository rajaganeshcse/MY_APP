<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================================================= -->
    <!-- MAIN HOME SCREEN CONTAINER -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFF">

        <!-- ============================================================
             FULL GRADIENT BACKGROUND (MATCHING SCRATCH ACTIVITY)
             ============================================================ -->
        <View
            android:id="@+id/bgGradient"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scratch_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ============================================================
             DECORATIVE GLOW CIRCLE - TOP RIGHT
             ============================================================ -->
        <View
            android:id="@+id/glowCircle"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:alpha="0.28"
            android:background="@drawable/bg_glow_circle"
            android:translationX="70dp"
            android:translationY="-70dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ============================================================
             MAIN CONTENT COLUMN
             ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- ================= HEADER ================= -->

            <RelativeLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:paddingStart="16dp"
                android:paddingTop="30dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Drawer Menu Button -->
                <ImageView
                    android:id="@+id/menuIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_back_light"
                    android:padding="9dp"
                    android:src="@drawable/menu_bar_icon"
                    android:tint="#1E293B"
                    android:contentDescription="Menu"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- User Greeting Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/menuIcon"
                    android:layout_toStartOf="@id/rightHeaderActions"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtGreetingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back 👋"
                        android:textColor="#64748B"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txtUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gamer"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                </LinearLayout>

                <!-- Right Actions: Streak & Notification -->
                <LinearLayout
                    android:id="@+id/rightHeaderActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Flame / Streak -->
                    <ImageView
                        android:id="@+id/strikeIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_back_light"
                        android:padding="7dp"
                        android:src="@drawable/flame"
                        android:contentDescription="Streak"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Notification -->
                    <ImageView
                        android:id="@+id/notification"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_back_light"
                        android:padding="8dp"
                        android:src="@drawable/notification_icon"
                        android:tint="#1E293B"
                        android:contentDescription="Notification"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

            </RelativeLayout>


            <!-- ================= DASHBOARD SCROLL CONTENT ================= -->

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="24dp">

                    <!-- ================= TOP CARD CONTAINER (FLIPPABLE DAILY BONUS & WALLET BALANCE) ================= -->
                    <FrameLayout
                        android:id="@+id/topCardContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <!-- PRIMARY WALLET / BALANCE CARD -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardWalletBalance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="6dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@android:color/transparent">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_balance_card_gradient"
                                android:paddingStart="18dp"
                                android:paddingTop="16dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="14dp">

                                <!-- DECORATIVE WALLET GLOW ACCENT -->
                                <View
                                    android:id="@+id/glowCircleWallet"
                                    android:layout_width="140dp"
                                    android:layout_height="140dp"
                                    android:alpha="0.22"
                                    android:background="@drawable/bg_wallet_glow_circle"
                                    android:translationX="30dp"
                                    android:translationY="-30dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <!-- ================= TOP LEFT: COIN BALANCE ================= -->
                                <LinearLayout
                                    android:id="@+id/lblGroup"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <View
                                        android:layout_width="7dp"
                                        android:layout_height="7dp"
                                        android:background="@drawable/bg_back_light"
                                        android:backgroundTint="#FFD700" />

                                    <TextView
                                        android:id="@+id/lblTotalBalance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="COIN BALANCE"
                                        android:textColor="#C7D2FE"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="0.08" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/coinBalanceGroup"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="4dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/lblGroup">

                                    <ImageView
                                        android:id="@+id/coin"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ic_coin"
                                        android:contentDescription="Coins"/>

                                    <TextView
                                        android:id="@+id/txtUserCoins"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="0"
                                        android:textColor="#FFD700"
                                        android:textSize="26sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="0.02"/>

                                </LinearLayout>

                                <!-- ================= TOP RIGHT: TICKET BALANCE ================= -->
                                <LinearLayout
                                    android:id="@+id/lblTicketGroup"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent">

                                    <View
                                        android:layout_width="7dp"
                                        android:layout_height="7dp"
                                        android:background="@drawable/bg_back_light"
                                        android:backgroundTint="#38BDF8" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="TICKETS"
                                        android:textColor="#C7D2FE"
                                        android:textSize="11sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="0.08" />

                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/ticketBalanceGroup"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:layout_marginTop="4dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/lblTicketGroup">

                                    <ImageView
                                        android:id="@+id/imgTicketIcon"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:src="@drawable/ic_ticket"
                                        android:contentDescription="Tickets"/>

                                    <TextView
                                        android:id="@+id/txtToken"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="0"
                                        android:textColor="#38BDF8"
                                        android:textSize="26sp"
                                        android:textStyle="bold"
                                        android:letterSpacing="0.02"/>

                                </LinearLayout>

                                <!-- ================= DIVIDER ================= -->
                                <View
                                    android:id="@+id/dividerWallet"
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="#20FFFFFF"
                                    android:layout_marginTop="12dp"
                                    app:layout_constraintTop_toBottomOf="@id/coinBalanceGroup"/>

                                <!-- ================= BOTTOM ROW ================= -->
                                <!-- Bottom Left Helper Note -->
                                <TextView
                                    android:id="@+id/txtWalletNote"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginEnd="12dp"
                                    android:text="⚡ Convert coins to cash &amp; rewards"
                                    android:textColor="#F1F5F9"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/btnRedeemBalance"
                                    app:layout_constraintTop_toBottomOf="@id/dividerWallet"
                                    app:layout_constraintBottom_toBottomOf="parent"/>

                                <!-- Bottom Right Redeem Action Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRedeemBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="8dp"
                                    android:text="REDEEM ➔"
                                    android:textColor="#4338CA"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.04"
                                    app:cornerRadius="18dp"
                                    app:backgroundTint="#FFFFFF"
                                    app:elevation="3dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/dividerWallet"
                                    app:layout_constraintBottom_toBottomOf="parent"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- DAILY BONUS CARD -->
                        <include layout="@layout/card_dailybonus"/>

                    </FrameLayout>

                    <!-- ================= HIGHLIGHT OFFER (HIT REWARDZ) ================= -->
                    <include layout="@layout/card_hit_rewardz"/>

                    <!-- ================= QUICK REWARDS GRID (2 COLUMNS) ================= -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"
                        android:text="Quick Rewards"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"/>

                    <!-- Row 1: Spin & Scratch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <include layout="@layout/card_spinner" />

                        <include layout="@layout/card_scratch" />

                    </LinearLayout>

                    <!-- Row 2: Watch & Earn + Daily Quiz -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <include layout="@layout/card_watch_earn" />

                        <include layout="@layout/card_daily_quiz" />

                    </LinearLayout>

                    <!-- Row 3: Tasks & Surveys -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <include layout="@layout/card_tasks" />

                        <include layout="@layout/card_surveys" />

                    </LinearLayout>

                    <!-- ================= PLAY & EARN (GAMES / TOURNAMENTS) ================= -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="8dp"
                        android:layout_marginStart="4dp"
                        android:text="Play &amp; Earn"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"/>

                    <include layout="@layout/card_lucky_draw" />

                    <!-- ================= REFERRAL BANNER ================= -->
                    <include layout="@layout/card_invite" />

                    <!-- ================= AD CONTAINER ================= -->
                    <FrameLayout
                        android:id="@+id/nativeAdContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"/>

                </LinearLayout>

            </ScrollView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================================================= -->
    <!-- NAVIGATION DRAWER -->
    <!-- ================================================= -->

    <FrameLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <include
            layout="@layout/drawer_menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>