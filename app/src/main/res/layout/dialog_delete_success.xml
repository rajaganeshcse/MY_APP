<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_scratch_gradient"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- ANIMATED GREEN SUCCESS CHECK CONTAINER -->
        <FrameLayout
            android:id="@+id/successContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center">

            <!-- Green Success Badge -->
            <ImageView
                android:id="@+id/successBadge"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_success"
                android:scaleX="0"
                android:scaleY="0"
                android:contentDescription="Success Badge" />

            <!-- White Check (AnimatedVectorDrawable) -->
            <ImageView
                android:id="@+id/checkIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/animated_check"
                android:alpha="0"
                android:contentDescription="Checkmark" />

        </FrameLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Account Deletion Pending"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <!-- 7-DAY REVIEW BADGE CHIP -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="⏳ Under 7-Day Review Period"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_streak_badge_active" />

        <!-- MESSAGE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Your account deletion request has been submitted successfully. Your account and data will be reviewed and permanently deleted after 7 days."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- SUPPORT CONTACT BOX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_reward_info"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_info_blue"
                android:contentDescription="Info Icon" />

            <TextView
                android:id="@+id/tvDeleteSuccessEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="You have been signed out. Contact loco209832@gmail.com within 7 days to cancel this request."
                android:textColor="#1D4ED8"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- ACTION BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogOk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:minHeight="0dp"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textAllCaps="false"
            app:backgroundTint="@color/bule_color2"
            app:cornerRadius="25dp"
            app:rippleColor="#40FFFFFF"
            app:elevation="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
