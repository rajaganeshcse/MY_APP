<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Logo Placeholder -->
        <View
            android:id="@+id/shimmerLogo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title Placeholder -->
        <View
            android:id="@+id/shimmerTitle"
            android:layout_width="140dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintStart_toEndOf="@+id/shimmerLogo"
            app:layout_constraintTop_toTopOf="@+id/shimmerLogo" />

        <!-- Tag Placeholder -->
        <View
            android:id="@+id/shimmerTag"
            android:layout_width="55dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/shimmerTitle" />

        <!-- Short Description Line 1 -->
        <View
            android:id="@+id/shimmerDesc1"
            android:layout_width="0dp"
            android:layout_height="13dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/shimmerTitle"
            app:layout_constraintTop_toBottomOf="@+id/shimmerTitle" />

        <!-- Short Description Line 2 -->
        <View
            android:id="@+id/shimmerDesc2"
            android:layout_width="130dp"
            android:layout_height="13dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_shimmer_placeholder"
            app:layout_constraintStart_toStartOf="@+id/shimmerTitle"
            app:layout_constraintTop_toBottomOf="@+id/shimmerDesc1" />

        <!-- Bottom Row: Reward Chip & Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/shimmerLogo">

            <!-- Reward Chip Placeholder -->
            <View
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <!-- Visit Button Placeholder -->
            <View
                android:layout_width="100dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_shimmer_placeholder" />

            <!-- Share Button Placeholder -->
            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_shimmer_placeholder" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
