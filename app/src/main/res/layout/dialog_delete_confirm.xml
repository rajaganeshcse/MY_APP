<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_scratch_gradient"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- WARNING ICON BADGE -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_warning_circle">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning_delete"
                android:contentDescription="Warning Badge" />

        </FrameLayout>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Delete Account?"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <!-- SUBTITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Are you sure you want to request account deletion? This action will submit your account for a 7-day review period."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- BUTTONS ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- CANCEL -->
            <TextView
                android:id="@+id/btnDialogCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="#64748B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_delete_back"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <!-- DELETE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogDelete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Delete"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:backgroundTint="#EF4444"
                app:cornerRadius="24dp"
                app:elevation="4dp"
                app:strokeWidth="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
