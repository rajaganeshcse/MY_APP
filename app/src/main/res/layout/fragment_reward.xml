<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dark_activity_gradient"
    android:overScrollMode="never"
    android:scrollbars="none">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Ambient Glow Backdrop Circle -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:alpha="0.15"
            android:background="@drawable/bg_glow_circle"
            android:translationX="100dp"
            android:translationY="-60dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Screen Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Reward Store"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Redeem coins for real cash &amp; voucher codes"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <!-- Coins Balance Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_balance_card_gradient"
                android:elevation="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AVAILABLE BALANCE"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textColor="#FFD700"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coins"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:contentDescription="Coins Icon"
                    android:src="@drawable/ic_coin" />

            </LinearLayout>

            <!-- Rewards History Button -->
            <LinearLayout
                android:id="@+id/btnHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card_glass"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📜 Rewards &amp; Withdrawal History"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="History Arrow"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#94A3B8" />

            </LinearLayout>

            <!-- Section Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="14dp"
                android:letterSpacing="0.01"
                android:text="Select Payout Method"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Dynamic Options (Shown / Hidden by Firestore config) -->
            <include
                android:id="@+id/upiOption"
                layout="@layout/item_reward_option" />

            <include
                android:id="@+id/bankOption"
                layout="@layout/item_reward_option" />

            <include
                android:id="@+id/googleOption"
                layout="@layout/item_reward_option" />

            <include
                android:id="@+id/amazonOption"
                layout="@layout/item_reward_option" />

            <include
                android:id="@+id/phonepeOption"
                layout="@layout/item_reward_option" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>
