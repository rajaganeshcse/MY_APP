<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <!-- ============================================================
             1. CIRCULAR SUCCESS ICON CONTAINER (64dp x 64dp)
             ============================================================ -->
        <FrameLayout
            android:id="@+id/successContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_success_icon_container">

            <ImageView
                android:id="@+id/checkIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981"
                android:contentDescription="Success Icon" />

        </FrameLayout>

        <!-- ============================================================
             2. SUCCESS TITLE
             ============================================================ -->
        <TextView
            android:id="@+id/txtSuccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Entry Confirmed!"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ============================================================
             3. SUCCESS MESSAGE
             ============================================================ -->
        <TextView
            android:id="@+id/txtSuccessMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Joined with 1 Ticket"
            android:textColor="#059669"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- ============================================================
             4. TOKEN CONTAINER CARD
             ============================================================ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTokensContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#F8FAFC"
            app:cardElevation="0dp"
            app:strokeColor="#C7D2FE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_token"
                        android:contentDescription="Token" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="YOUR TICKET TOKEN(S)"
                        android:textColor="#4F46E5"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                </LinearLayout>

                <!-- Token List ScrollView -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="160dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/layoutTokensList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <TextView
                            android:id="@+id/txtTokensList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="A7K2P"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:typeface="monospace"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================
             5. IMPORTANT INFORMATION
             ============================================================ -->
        <TextView
            android:id="@+id/txtDetailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Save your ticket token(s). The winner will be selected when the draw is completed."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- ============================================================
             6. FINAL BUTTON
             ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAwesome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Awesome!"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#10B981"
            app:cornerRadius="14dp"
            app:elevation="3dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
