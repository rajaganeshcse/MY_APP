<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- ============================================================
         FULL GRADIENT BACKGROUND (LIGHT MODE)
         ============================================================ -->

    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scratch_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============================================================
         DECORATIVE GLOW CIRCLE - TOP RIGHT
         ============================================================ -->
    <View
        android:id="@+id/glowCircle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.30"
        android:background="@drawable/bg_glow_circle"
        android:translationX="60dp"
        android:translationY="-60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         MAIN SCROLL CONTAINER
         ============================================================ -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- ======================================================
                 HEADER ROW
                 ====================================================== -->

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="30dp"
                android:paddingBottom="10dp">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:src="@drawable/back_arrow"
                    app:tint="#1E293B"
                    android:background="@drawable/bg_delete_back"
                    android:contentDescription="Back" />

                <!-- Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/txtScratch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lucky Scratch"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/txtSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scratch &amp; reveal your reward"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Coin Balance Chip -->
                <LinearLayout
                    android:id="@+id/coinContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_chip_light"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/imgCoin"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_coin"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/txtCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="0"
                        android:textColor="#D97706"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ======================================================
                 SCRATCH COUNT CHIP
                 ====================================================== -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_delete_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/txtScratchLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Scratches left today: "
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtScratchCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#4F46E5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ======================================================
                 SCRATCH CARD CONTAINER
                 ====================================================== -->

            <FrameLayout
                android:id="@+id/scratchCardContainer"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="28dp"
                android:gravity="center">

                <!-- Card shadow layer -->
                <View
                    android:layout_width="270dp"
                    android:layout_height="310dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card_shadow"
                    android:translationY="8dp"
                    android:alpha="0.25" />

                <!-- ScratchView -->
                <com.app.rewardsplanet.lucky_draw.ScratchView
                    android:id="@+id/scratchView"
                    android:layout_width="270dp"
                    android:layout_height="310dp"
                    android:layout_gravity="center" />

            </FrameLayout>

            <!-- ======================================================
                 HINT TEXT
                 ====================================================== -->

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="✨  Scratch the card to reveal your prize!"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- ======================================================
                 ADVERTISEMENT BANNER
                 ====================================================== -->

            <LinearLayout
                android:id="@+id/adContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0" />

                <TextView
                    android:id="@+id/txtAdvertisement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="ADVERTISEMENT"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:letterSpacing="0.10" />

                <com.google.android.gms.ads.AdView
                    xmlns:ads="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/adView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    ads:adSize="BANNER"
                    ads:adUnitId="@string/banner_ad_unit_id" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>