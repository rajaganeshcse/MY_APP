<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffffff">

    <!-- Background circle -->

    <View
        android:id="@+id/bg_shape_left"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:alpha="0.35"
        android:background="@drawable/bg_circle_light"
        android:translationX="-65dp"
        android:translationY="170dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Background circle -->

    <View
        android:id="@+id/bg_shape_right"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:alpha="0.25"
        android:background="@drawable/bg_circle_light"
        android:translationX="55dp"
        android:translationY="55dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main -->

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Header -->

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back -->

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="23dp"
                android:src="@drawable/back_arrow"
                android:background="@drawable/bg_delete_back"
                android:contentDescription="Back"/>

            <!-- Profile -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                android:paddingStart="5dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="7dp"
                    android:layout_gravity="center_horizontal"

                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtScratch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Lucky Scratch"

                        android:textColor="@color/black"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Coin balance -->

            <LinearLayout
                android:id="@+id/coinContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgCoin"
                    android:layout_width="36dp"
                    android:layout_height="30dp"

                    android:contentDescription="Coins"

                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/txtCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="5dp"

                    android:text="144"

                    android:textColor="#111827"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>



        <!-- Scratch count -->

        <TextView
            android:id="@+id/txtScratchCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            android:gravity="center"

            android:text="Your Today Scratch Count left = 8"

            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- Scratch card -->

        <FrameLayout
            android:id="@+id/scratchCardContainer"
            android:layout_width="match_parent"
            android:layout_height="350dp"

            android:layout_marginTop="60dp"

            android:gravity="center">

            <com.app.rewardsplanet.lucky_draw.ScratchView
                android:id="@+id/scratchView"

                android:layout_width="280dp"
                android:layout_height="330dp"

                android:layout_gravity="center" />

        </FrameLayout>

        <!-- Advertisement Banner -->
        <LinearLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D9DCE5" />

            <TextView
                android:id="@+id/txtAdvertisement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="ADVERTISEMENT"
                android:textColor="#7B8190"
                android:textSize="13sp"
                android:letterSpacing="0.08" />

            <com.google.android.gms.ads.AdView
                xmlns:ads="http://schemas.android.com/apk/res-auto"
                android:id="@+id/bannerAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                ads:adSize="BANNER"
                ads:adUnitId="@string/banner_ad_unit_id" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>