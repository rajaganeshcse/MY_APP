<?xml version="1.0" encoding="utf-8"?>
<!--
    item_top1.xml — Podium layout for Top 3 leaderboard positions.
    Layout order (L→R): 2nd | 1st | 3rd  (standard podium arrangement)
    Fixes: corrected emoji, silver bg for 2nd, dark themed text colors.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp">

    <!-- ================================================= -->
    <!-- 2ND PLACE (left)                                   -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <!-- Silver medal badge -->
        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="🥈"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Profile image -->
        <ImageView
            android:id="@+id/img2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_profile_circle"
            android:scaleType="centerCrop"
            android:contentDescription="2nd place" />

        <!-- Name -->
        <TextView
            android:id="@+id/name2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="—"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/score2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Podium block — silver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_silver"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2nd"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- 1ST PLACE (center, tallest)                        -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Crown icon -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="36dp"
            android:layout_marginBottom="2dp"
            android:scaleType="centerInside"
            android:src="@drawable/crown"
            android:contentDescription="Winner crown" />

        <!-- Profile image -->
        <ImageView
            android:id="@+id/img1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_profile_circle"
            android:scaleType="centerCrop"
            android:contentDescription="1st place" />

        <!-- Name -->
        <TextView
            android:id="@+id/name1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="—"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/score1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Podium block — gold (tallest) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_gold"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 1st"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- 3RD PLACE (right)                                  -->
    <!-- ================================================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp" />

        <!-- Bronze medal badge -->
        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="🥉"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Profile image -->
        <ImageView
            android:id="@+id/img3"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_profile_circle"
            android:scaleType="centerCrop"
            android:contentDescription="3rd place" />

        <!-- Name -->
        <TextView
            android:id="@+id/name3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:text="—"
            android:textColor="#000000"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_coin"
                android:contentDescription="Coins" />

            <TextView
                android:id="@+id/score3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="0"
                android:textColor="#FFD700"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Podium block — bronze -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_bronze"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3rd"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
