<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/footerSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_footer_card"
    android:elevation="2dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="20dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">

    <!-- ================= BRAND & TAGLINE ================= -->
    <TextView
        android:id="@+id/txtFooterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="REWARDSPRO 💙 INDIA"
        android:textColor="#1E40AF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.03" />

    <TextView
        android:id="@+id/txtFooterTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Earn • Play • Complete • Redeem"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- ================= WHY CHOOSE US ================= -->
    <TextView
        android:id="@+id/txtWhyChooseUsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Why Choose Us"
        android:textColor="#0F172A"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <!-- 3 EVENLY SPACED ITEMS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- 🔒 Secure -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🔒 Secure"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Protected Data"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- ⚡ Fast -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡ Fast"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Instant Payouts"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 📊 Transparent -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="📊 Transparent"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Realtime Stats"
                android:textColor="#64748B"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ================= SUBTLE DIVIDER ================= -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="14dp"
        android:background="#E2E8F0" />

    <!-- ================= FOOTER LINKS ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFooterAboutUs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="About Us"
            android:textColor="#2563EB"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#CBD5E1"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnFooterSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Support"
            android:textColor="#2563EB"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#CBD5E1"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnFooterTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Terms"
            android:textColor="#2563EB"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#CBD5E1"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/btnFooterPrivacy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:text="Privacy Policy"
            android:textColor="#2563EB"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ================= COPYRIGHT ================= -->
    <TextView
        android:id="@+id/txtFooterCopyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="© 2026 RewardsPro. All rights reserved."
        android:textColor="#94A3B8"
        android:textSize="11sp" />

</LinearLayout>
