<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="265dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"

    app:cardCornerRadius="24dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="@android:color/white"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="15dp">

        <!-- SUCCESS ICON -->

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingBottom="25dp"
            android:text="    Congratulations ! 🎉"
            android:textColor="@color/color_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_success" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="You earned"
            android:textColor="@color/color_violet"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgWinCoin"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="5dp"
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/txtWinAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Coins"
                android:textColor="#F97316"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtCurrentBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Current Balance: 112 Coins"
            android:textColor="#172554"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOk"
            android:layout_width="232dp"
            android:layout_height="52dp"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:text="COLLECT"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9638"
            app:cornerRadius="23dp"
            app:elevation="0dp"
            app:strokeWidth="0dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>