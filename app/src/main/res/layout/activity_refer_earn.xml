<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- GRADIENT BACKGROUND MATCHING SCRATCH ACTIVITY -->
    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scratch_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- DECORATIVE GLOW CIRCLE - TOP RIGHT -->
    <View
        android:id="@+id/glowCircle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.30"
        android:background="@drawable/bg_glow_circle"
        android:translationX="60dp"
        android:translationY="-60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- HEADER ROW MATCHING SCRATCH ACTIVITY -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="36dp"
            android:paddingBottom="12dp">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/back_arrow"
                app:tint="#1E293B"
                android:background="@drawable/bg_delete_back"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refer &amp; Earn 🎁"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:id="@+id/txtHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invite friends &amp; collect rewards"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Coin Balance Chip -->
            <LinearLayout
                android:id="@+id/coinContainer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_chip_light"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/imgCoin"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_coin"
                    android:contentDescription="Coins" />

                <TextView
                    android:id="@+id/txtCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="0"
                    android:textColor="#D97706"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- TABS -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="#4F46E5"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="#4F46E5"
            app:tabTextColor="#64748B"
            app:tabRippleColor="#204F46E5">

            <com.google.android.material.tabs.TabItem
                android:text="INVITE FRIENDS"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

            <com.google.android.material.tabs.TabItem
                android:text="MY EARNINGS"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

        </com.google.android.material.tabs.TabLayout>

        <!-- VIEWPAGER2 CONTAINER FOR LEFT/RIGHT SWIPE DRAG -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Google Mobile Ads Banner -->
        <com.google.android.gms.ads.AdView
            xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/adViewRefer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            ads:adSize="BANNER"
            ads:adUnitId="@string/banner_ad_unit_id" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
