<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_scratch_gradient"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- GREEN SCALLOPED VERIFIED CHECKMARK ICON (MATCHING SCREENSHOT 2) -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/done_icon"
            android:contentDescription="Success Badge" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Profile Saved Successfully!"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <!-- MESSAGE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Your profile details have been saved and synchronized with your account."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4" />

        <!-- ACTION BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileSuccessOk"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:minHeight="0dp"
            android:text="Confirm"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:textAllCaps="false"
            app:backgroundTint="@color/bule_color2"
            app:cornerRadius="25dp"
            app:rippleColor="#40FFFFFF"
            app:elevation="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
