<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- BACKGROUND GRADIENT & DECORATIVE GLOW -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scratch_gradient" />

        <View
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:alpha="0.20"
            android:background="@drawable/bg_glow_circle"
            android:translationX="50dp"
            android:translationY="-50dp"
            android:layout_gravity="top|end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- SUCCESS ICON BADGE -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_light">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_success"
                    android:contentDescription="Success"
                    app:tint="#16A34A" />

            </FrameLayout>

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Profile Saved Successfully!"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <!-- MESSAGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Your profile changes have been saved and synchronized locally with your account."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.4" />

            <!-- ACTION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileSuccessOk"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:minHeight="0dp"
                android:text="Continue to Home"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:textAllCaps="false"
                app:backgroundTint="@color/bule_color2"
                app:cornerRadius="25dp"
                app:rippleColor="#40FFFFFF"
                app:elevation="4dp" />

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
