<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PROFILE HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="101dp"

            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_social_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- LEFT SIDE : NAME + UID -->
            <LinearLayout
                android:layout_width="285dp"
                android:layout_height="101dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="251dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="10dp"
                        android:text="User Name"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/verified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginStart="0dp"
                        android:src="@drawable/verified_icon" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="251dp"
                    android:layout_height="31dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Code :"
                        android:textColor="@color/Primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/btnCopy"
                        android:layout_width="32dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_copy" />
                </LinearLayout>
            </LinearLayout>


            <!-- RIGHT SIDE : PROFILE IMAGE -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circle_bg"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />
        </LinearLayout>


        <!-- WALLET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- COINS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="79dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reward_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="37dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/txtCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Coins"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- TICKETS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="79dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_history"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_ticket" />

                <TextView
                    android:id="@+id/txtTickets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Tickets"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>


        <!-- MENU -->
        <!-- Account History -->
        <LinearLayout
            android:id="@+id/btnAccountHistory"
            style="@style/ProfileRow"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_history" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Account History"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- My Rewards -->
        <LinearLayout
            android:id="@+id/btnMyRewards"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_reward" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="My Rewards"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/invite"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_invite" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Refferal Activity"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Help / FAQ -->
        <LinearLayout
            android:id="@+id/btnHelp"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_help" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Help | FAQ"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Privacy Policy -->
        <LinearLayout
            android:id="@+id/btnPrivacy"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:src="@drawable/ic_privacy" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Privacy Policy"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Terms & Conditions -->
        <LinearLayout
            android:id="@+id/btnTerms"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="41dp"
                android:src="@drawable/ic_terms" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Terms | Conditions"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/btnLogout"
            style="@style/ProfileRow">

            <ImageView
                android:layout_width="43dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_logout" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Logout"
                android:textStyle="bold"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- ================= SOCIAL MEDIA SECTION ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/bg_social_card"
            android:padding="16dp">

            <!-- Facebook -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_facebook"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facebook"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnFacebook"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Like Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- Instagram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_instagram"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instagram"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnInstagram"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Follow Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- Telegram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_telegram"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Telegram"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnTelegram"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Join Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- YouTube -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_youtube"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YouTube"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnYoutube"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Subscribe"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>



</ScrollView>
