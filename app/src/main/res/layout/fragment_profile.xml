<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- PROFILE HEADER -->
        <LinearLayout
            android:layout_width="393dp"
            android:layout_height="101dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="98dp"
                android:layout_height="match_parent"
                android:background="@drawable/circle_bg"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtUid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UID"
                    android:textColor="#777"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- WALLET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/txtCoins"
                android:layout_width="1dp"
                android:layout_height="121dp"
                android:layout_weight="1"
                android:background="@drawable/bg_coin_gradient"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="0 Coins"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTickets"
                android:layout_width="7dp"
                android:layout_height="121dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_token_gradient"
                android:gravity="center"
                android:textColor="@color/black"
                android:text="0 Tickets"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MENU -->
        <LinearLayout
            android:id="@+id/btnAccountHistory"
            style="@style/ProfileRow"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_history"
            android:text="Account History">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_history"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account History"
                android:textFontWeight="1"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btnMyRewards"
            style="@style/ProfileRow"
            android:drawableStart="@drawable/ic_reward"
            android:text="My Rewards">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_reward"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Rewards"
                android:textFontWeight="1"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btnHelp"
            style="@style/ProfileRow"
            android:drawableStart="@drawable/ic_help"
            android:text="Help || FAQ">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_help"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Help || FAQ"
        android:textFontWeight="1"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:textColor="@color/black"
        />
        </LinearLayout>


    <LinearLayout
            android:id="@+id/btnPrivacy"
            style="@style/ProfileRow"
            android:drawableStart="@drawable/ic_privacy"
            android:orientation="horizontal"
            android:text="Privacy Policy">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_privacy"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textFontWeight="3"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                />
    </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTerms"
            style="@style/ProfileRow"
            android:drawableStart="@drawable/ic_terms"
            android:text="Terms || Conditions">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_terms"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms || Conditions"
                android:textFontWeight="1"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLogout"
            style="@style/ProfileRow"
            android:drawableStart="@drawable/ic_logout"
            android:text="Logout">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_logout"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textFontWeight="1"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                />
        </LinearLayout>
        <!-- ================= SOCIAL MEDIA SECTION ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/bg_social_card"
            android:padding="16dp">

            <!-- Facebook -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_facebook"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Facebook"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnFacebook"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Like Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- Instagram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_instagram"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instagram"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnInstagram"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Follow Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- Telegram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_telegram"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Telegram"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnTelegram"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Join Us"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

            <!-- YouTube -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_youtube"
                    android:layout_marginEnd="12dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="YouTube"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btnYoutube"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="Subscribe"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:background="@drawable/bg_social_button"/>
            </LinearLayout>

        </LinearLayout>
        </LinearLayout>



</ScrollView>
