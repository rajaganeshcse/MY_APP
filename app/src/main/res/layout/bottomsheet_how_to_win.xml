<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How to win Coins ⭐ ?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000"/>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"/>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginVertical="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:lineSpacingExtra="6dp"
        android:text="Step 1 :"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Win Coins by participating in Esports tournaments"
        android:textColor="#444"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:lineSpacingExtra="6dp"
        android:text="Step 2 :"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Earn ticket from watch ads and use to join tounament"
        android:textColor="#444"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:lineSpacingExtra="6dp"
        android:text="Step 3 :"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Result are announced after score verification"
        android:textColor="#444"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="25dp"
        android:lineSpacingExtra="6dp"
        android:text="Step 4 :"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="Registration closes 30 minutes before start time"
        android:textColor="#444"
        android:textStyle="bold" />
</LinearLayout>
