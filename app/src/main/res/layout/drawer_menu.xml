<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFF">

    <!-- ================================================= -->
    <!-- PROFILE HEADER (PREMIUM DARK GRADIENT) -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_drawer_header_gradient"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp">

        <!-- PROFILE IMAGE -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:padding="2dp"
                android:contentDescription="Profile"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_profile_circle"
                android:src="@drawable/ic_profile" />

        </FrameLayout>

        <!-- USER INFO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- USER NAME -->
            <TextView
                android:id="@+id/txtDrawerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, User"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- PHONE + COPY -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtDrawerPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9999999999"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02" />

                <ImageView
                    android:id="@+id/btnCopy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    app:tint="#38BDF8"
                    android:clickable="true"
                    android:contentDescription="Copy phone number"
                    android:focusable="true"
                    android:padding="2dp"
                    android:src="@drawable/ic_copy" />

            </LinearLayout>

        </LinearLayout>

        <!-- EDIT PROFILE -->
        <ImageView
            android:id="@+id/btnEditProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_edit_circle"
            android:contentDescription="Edit Profile"
            android:padding="7dp"
            android:scaleType="centerInside"
            app:tint="#FFFFFF"
            android:src="@drawable/ic_edit" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- MENU SCROLL -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================================================= -->
            <!-- QUICK STATS (COINS & TICKETS) -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:weightSum="2">

                <!-- COIN HISTORY CHIP -->
                <LinearLayout
                    android:id="@+id/coinhistory"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_drawer_stat_chip"
                    android:elevation="1dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_coin"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/txtCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                </LinearLayout>

                <!-- TICKET HISTORY CHIP -->
                <LinearLayout
                    android:id="@+id/tickethistory"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_drawer_stat_chip"
                    android:elevation="1dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_ticket"
                        android:contentDescription="Tickets" />

                    <TextView
                        android:id="@+id/txtTickets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                </LinearLayout>

            </LinearLayout>


            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="4dp"
                android:background="#E2E8F0" />


            <!-- ================================================= -->
            <!-- SECTION: MY ACCOUNT -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="MY ACCOUNT"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- ACCOUNT HISTORY (FORMERLY WALLET) -->
            <LinearLayout
                android:id="@+id/menuWallet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_purple"
                    android:padding="7dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="Account History" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Account History"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- LEADERBOARD -->
            <LinearLayout
                android:id="@+id/menuLeaderboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_amber"
                    android:padding="7dp"
                    android:src="@drawable/ic_leaderboard"
                    android:contentDescription="Leaderboard" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Leaderboard"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- MY ACTIVITY -->
            <LinearLayout
                android:id="@+id/menuActivity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="7dp"
                    android:src="@drawable/ic_gift"
                    android:contentDescription="My Activity" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Activity"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- REFER AND EARN -->
            <LinearLayout
                android:id="@+id/menuRefer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_green"
                    android:padding="7dp"
                    app:tint="#16A34A"
                    android:src="@drawable/ic_invite"
                    android:contentDescription="Refer and Earn" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Refer &amp; Earn"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>


            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="8dp"
                android:background="#E2E8F0" />


            <!-- ================================================= -->
            <!-- SECTION: MORE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="MORE"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- RATE US -->
            <LinearLayout
                android:id="@+id/menuRate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_amber"
                    android:padding="7dp"
                    app:tint="#D97706"
                    android:src="@drawable/rate_us"
                    android:contentDescription="Rate Us" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Rate Us"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- FEEDBACK -->
            <LinearLayout
                android:id="@+id/menuFeedback"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_sky"
                    android:padding="7dp"
                    app:tint="#0284C7"
                    android:src="@drawable/ic_privacy"
                    android:contentDescription="Feedback" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Feedback"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- CONTACT US -->
            <LinearLayout
                android:id="@+id/menuContact"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_violet"
                    android:padding="7dp"
                    app:tint="#7C3AED"
                    android:src="@drawable/ic_help"
                    android:contentDescription="Contact Us" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Contact Us"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- FAQ -->
            <LinearLayout
                android:id="@+id/menuFaq"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_blue"
                    android:padding="7dp"
                    app:tint="#4F46E5"
                    android:src="@drawable/ic_terms"
                    android:contentDescription="FAQ" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="FAQ's"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>

            <!-- PRIVACY POLICY -->
            <LinearLayout
                android:id="@+id/menuPrivacy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_slate"
                    android:padding="7dp"
                    app:tint="#475569"
                    android:src="@drawable/ic_privacy"
                    android:contentDescription="Privacy Policy" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Privacy Policy"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01" />

            </LinearLayout>


            <!-- DIVIDER BEFORE LOGOUT -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:background="#E2E8F0" />


            <!-- LOGOUT -->
            <LinearLayout
                android:id="@+id/btnLogout1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="2dp"
                android:background="@drawable/bg_drawer_item_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_icon_circle_red"
                    android:padding="7dp"
                    app:tint="#EF4444"
                    android:src="@drawable/ic_logout"
                    android:contentDescription="Logout" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Logout"
                    android:textColor="#EF4444"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

            </LinearLayout>


            <!-- BOTTOM FOOTER IN DRAWER -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="version 1.0.0"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.03" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:text="REWARDSPRO 💙 INDIA"
                android:layout_marginBottom="24dp"
                android:textColor="#2563EB"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>