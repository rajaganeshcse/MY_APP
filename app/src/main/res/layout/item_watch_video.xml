<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWatchVideoRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#EEF2FF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SUPER BONUS BADGE BANNER (Shown for Super Bonus Item 10) -->
        <TextView
            android:id="@+id/badgeSuperBonus"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/bg_token_gradient"
            android:gravity="center"
            android:text="🔥 2X SUPER MEGA BONUS — +50 COINS &amp; +2 TICKETS 🔥"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <!-- METALLIC ICON CONTAINER -->
            <FrameLayout
                android:id="@+id/iconContainer"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_reward_chip">

                <ImageView
                    android:id="@+id/imgVideoIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_watch"
                    android:contentDescription="Watch Video Task" />

            </FrameLayout>

            <!-- TITLE & REWARD BADGES -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/txtVideoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Watch Video #1"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <!-- REWARD BADGES ROW -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- COIN CHIP -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_reward_chip"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_coin"
                            android:contentDescription="Coins" />

                        <TextView
                            android:id="@+id/txtVideoRewardCoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="+10 Coins"
                            android:textColor="#92400E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- TICKET CHIP -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_joined_chip"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/txtVideoRewardTickets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎟️ +1 Ticket"
                            android:textColor="#047857"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- WATCH / CLAIM ACTION BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchVideoItem"
                android:layout_width="106dp"
                android:layout_height="44dp"
                android:text="Watch 📺"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#10B981"
                app:cornerRadius="14dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
