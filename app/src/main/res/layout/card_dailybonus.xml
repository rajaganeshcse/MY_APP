<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/card_daily_bonus"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"

    android:rotationX="2"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_daily_bonus"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <!-- TITLE + GIFT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TEXT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDailyBonusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Bonus Reward"
                    android:layout_gravity="center"
                    android:textColor="#0F172A"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDailyBonusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_gravity="center"
                    android:text="Hold for 5 seconds to claim your daily bonus"
                    android:textColor="#334155"
                    android:textSize="12.5sp" />

            </LinearLayout>

            <!-- GIFT -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bonus_icon">

                <ImageView
                    android:id="@+id/imgDailyBonus"
                    android:layout_width="32dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gift1"
                    android:contentDescription="Gift Icon" />

            </FrameLayout>

        </LinearLayout>

        <!-- HOLD PROGRESS CONTAINER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp">

            <!-- PROGRESS BAR BACKGROUND FILL -->
            <ProgressBar
                android:id="@+id/progressHoldBonus"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_hold_progress_drawable" />

            <!-- CLAIM BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClaimBonus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="HOLD TO CLAIM 0%"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="21dp"
                app:elevation="0dp"
                app:strokeWidth="0dp" />

        </FrameLayout>

        <!-- INFO ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_info"
                app:tint="#334155"
                android:contentDescription="Info Icon" />

            <TextView
                android:id="@+id/txtBonusInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:text="Hold for 5 seconds to claim"
                android:textColor="#334155"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>