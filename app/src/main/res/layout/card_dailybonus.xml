<?xml version="1.0" encoding="utf-8"?>
<!--
    card_dailybonus.xml — Professional Daily Bonus Card UI Redesign.
    Features: Gradient card, glassmorphic gift badge, gold/orange progress fill, high-contrast typography.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_daily_bonus"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_daily_bonus"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <!-- TITLE + GIFT BADGE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TEXT COLUMN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/txtDailyBonusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁 Daily Bonus Reward"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01" />

                <TextView
                    android:id="@+id/txtDailyBonusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hold for 5 seconds to claim your daily bonus"
                    android:textColor="#E9D5FF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- GIFT BADGE -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_bonus_icon">

                <ImageView
                    android:id="@+id/imgDailyBonus"
                    android:layout_width="34dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gift1"
                    android:contentDescription="Gift Icon" />

            </FrameLayout>

        </LinearLayout>

        <!-- HOLD PROGRESS CONTAINER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="4dp">

            <!-- PROGRESS BAR BACKGROUND FILL -->
            <ProgressBar
                android:id="@+id/progressHoldBonus"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_hold_progress_drawable" />

            <!-- CLAIM BUTTON -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClaimBonus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="HOLD TO CLAIM 0%"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="24dp"
                app:elevation="0dp"
                app:strokeWidth="0dp" />

        </FrameLayout>

        <!-- INFO ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_info"
                app:tint="#FFD700"
                android:contentDescription="Info Icon" />

            <TextView
                android:id="@+id/txtBonusInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Hold for 5 seconds to claim"
                android:textColor="#F3E8FF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>