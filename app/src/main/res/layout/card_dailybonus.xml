<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/card_daily_bonus"
    android:layout_width="match_parent"
    android:layout_height="155dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"

    android:rotationX="2"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_daily_bonus"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <!-- TITLE + GIFT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TEXT -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDailyBonusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Streak Reward"
                    android:layout_gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDailyBonusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:layout_gravity="center"
                    android:text="Claim up to 100 coins every 24 hours"
                    android:textColor="#E4DCFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- GIFT -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_bonus_icon">

                <ImageView
                    android:id="@+id/imgDailyBonus"
                    android:layout_width="32dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_gift1" />

            </FrameLayout>

        </LinearLayout>

        <!-- CLAIM BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClaimBonus"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:text="CLAIM BONUS NOW"
            android:textColor="#4B35B8"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="21dp"
            app:elevation="0dp"
            app:strokeWidth="0dp" />

        <!-- INFO ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_info"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/txtBonusInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="6dp"
                android:gravity="center_horizontal"
                android:text="Rewards are randomly generated (1 - 50 coins)"
                android:textColor="#E3DBFF"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>