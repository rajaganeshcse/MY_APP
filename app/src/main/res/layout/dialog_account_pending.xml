<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_round"
    android:padding="24dp">

    <!-- ICON -->
    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_warning_circle">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_warning_delete"
            android:contentDescription="Warning"/>

    </FrameLayout>

    <!-- TITLE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:text="Account Under Review"
        android:textColor="#92400E"
        android:textSize="17sp"
        android:textStyle="bold"/>

    <!-- BADGE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="⏳  Pending Deletion"
        android:textColor="#D97706"
        android:textSize="11sp"
        android:textStyle="bold"
        android:background="@drawable/bg_amount_chip"/>

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#FDE68A"/>

    <!-- MESSAGE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Your account is currently under a 7-day deletion review.\n\nYou cannot log in during this period. Contact support if you wish to cancel this request."
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.5"/>

    <!-- CONTACT EMAIL -->
    <TextView
        android:id="@+id/tvAccountPendingEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="✉️ loco209832@gmail.com"
        android:textColor="#0066FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>

    <!-- OK BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccountPendingOk"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:minHeight="0dp"
        android:text="OK, Understood"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#D97706"
        app:cornerRadius="10dp"
        app:strokeWidth="0dp"/>

</LinearLayout>
