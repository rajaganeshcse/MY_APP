<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <!-- ============================================================
         BACKGROUND DECORATIVE GLOW ELEMENTS
         ============================================================ -->
    <View
        android:id="@+id/glowCircleTop"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.25"
        android:background="@drawable/bg_glow_circle"
        android:translationX="100dp"
        android:translationY="-80dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true" />

    <View
        android:id="@+id/glowCircleBottom"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="-150dp"
        android:alpha="0.18"
        android:background="@drawable/bg_glow_circle"
        android:translationX="-120dp"
        android:translationY="60dp" />

    <!-- ============================================================
         DECORATIVE FLOATING BACKGROUND COINS (2 COINS)
         ============================================================ -->
    <ImageView
        android:id="@+id/floatingCoin1"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="28dp"
        android:layout_marginTop="55dp"
        android:alpha="0.90"
        android:elevation="6dp"
        android:contentDescription="Floating Coin 1"
        android:src="@drawable/ic_coin" />

    <ImageView
        android:id="@+id/floatingCoin2"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="28dp"
        android:layout_marginTop="140dp"
        android:alpha="0.85"
        android:elevation="6dp"
        android:contentDescription="Floating Coin 2"
        android:src="@drawable/ic_coin" />

    <!-- ============================================================
         CENTER HERO BRANDING CONTAINER
         ============================================================ -->
    <LinearLayout
        android:id="@+id/splashHeroContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Curved Corner Logo Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardPreventCornerOverlap="false">

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />

        </androidx.cardview.widget.CardView>

        <!-- App Title (Deep Slate Navy) -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/app_name"
            android:textColor="#0F172A"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Subtitle (Muted Slate Grey) -->
        <TextView
            android:id="@+id/appSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/app_description"
            android:textColor="#475569"
            android:textSize="15sp" />

        <!-- Feature Badges Chips -->
        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_chip"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="🎮 Play &amp; Earn"
                android:textColor="#1E293B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_login_chip"
                android:elevation="2dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="💎 Instant Payouts"
                android:textColor="#D97706"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================================
         BOTTOM LOADING SPINNER & STATUS
         ============================================================ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:indeterminate="true"
            android:indeterminateTint="#4F46E5" />

        <TextView
            android:id="@+id/txtLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.02"
            android:text="Initializing..."
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
