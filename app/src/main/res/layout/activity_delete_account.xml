<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="30dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="13dp"
            android:src="@drawable/back_arrow"
            android:background="@drawable/bg_delete_back"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Delete Account"
            android:textColor="#101820"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center_vertical"/>

    </LinearLayout>


    <!-- DIVIDER -->

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E4EDF5"/>


    <!-- ================= CONTENT ================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">


            <!-- ================= MAIN CARD ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:background="@drawable/bg_delete_card">


                <!-- WARNING + TITLE -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_warning_circle">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning_delete"
                            android:contentDescription="Warning"/>

                    </FrameLayout>


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="We're sorry to see you go!"
                        android:textColor="#111827"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- DESCRIPTION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Deleting your account will permanently remove all your data, settings, and history. This action is not reversible. Please make sure you have saved anything important."
                    android:textColor="#4B5563"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>


                <!-- ================= PERMANENT ACTION ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:background="@drawable/bg_permanent_action">


                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_delete"
                        android:contentDescription="Delete"
                        android:tint="#D90016"/>


                    <TextView
                        android:id="@+id/txtPermanentAction"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="Permanent action: Once deleted, your account and all associated data cannot be recovered."
                        android:textColor="#B00012"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"/>

                </LinearLayout>


                <!-- CONFIRMATION TEXT -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="To confirm, type “Delete my account”"
                    android:textColor="#202124"
                    android:textSize="14sp"/>


                <!-- CONFIRMATION INPUT -->

                <EditText
                    android:id="@+id/edtConfirmation"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical"
                    android:hint="Write here"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:background="@drawable/bg_delete_input"/>


                <!-- DELETE BUTTON -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:text="Permanently Delete Account"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    app:backgroundTint="#EC0016"
                    app:cornerRadius="14dp"
                    app:strokeWidth="0dp"
                    app:rippleColor="#C90012"/>

            </LinearLayout>


            <!-- ================= HELP ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/bg_delete_help">


                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_info_blue"
                    android:contentDescription="Information"/>


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="Need help instead? Contact support before deleting your account."
                    android:textColor="#1F2937"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>