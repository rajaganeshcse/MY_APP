<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF">

    <!-- ============================================================
         FULL GRADIENT BACKGROUND (LIGHT MODE)
         ============================================================ -->
    <View
        android:id="@+id/bgGradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scratch_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ============================================================
         DECORATIVE GLOW CIRCLE - TOP RIGHT
         ============================================================ -->
    <View
        android:id="@+id/glowCircle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.30"
        android:background="@drawable/bg_glow_circle"
        android:translationX="60dp"
        android:translationY="-60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         MAIN SCROLL CONTAINER
         ============================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <!-- ======================================================
                 HEADER ROW
                 ====================================================== -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="30dp"
                android:paddingBottom="10dp">

                <!-- Back Button -->
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="13dp"
                    android:src="@drawable/back_arrow"
                    app:tint="#1E293B"
                    android:background="@drawable/bg_delete_back"
                    android:contentDescription="Back" />

                <!-- Title -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily Spin"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/txtSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spin the wheel &amp; win rewards"
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Coin Balance Chip -->
                <LinearLayout
                    android:id="@+id/layoutCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_chip_light"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_coin"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/txtCoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="0"
                        android:textColor="#D97706"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ======================================================
                 SPINS STATUS CHIP / CARD
                 ====================================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_delete_input"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtSpinsLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spins Left: 5"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ======================================================
                 WHEEL AREA
                 ====================================================== -->
            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="340dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp">

                <!-- Wheel -->
                <ImageView
                    android:id="@+id/imgWheel"
                    android:layout_width="310dp"
                    android:layout_height="310dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:padding="4dp"
                    android:src="@drawable/spin_wheel" />

                <!-- Pointer -->
                <ImageView
                    android:id="@+id/imgPointer"
                    android:layout_width="74dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_pointer" />

                <!-- COIN ANIMATION VIEW -->
                <ImageView
                    android:id="@+id/imgCoinAnim"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_coin"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- ======================================================
                 SPIN BUTTON
                 ====================================================== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpin"
                android:layout_width="220dp"
                android:layout_height="54dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_save_button"
                android:text="SPIN NOW"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:backgroundTint="@null"
                app:cornerRadius="27dp"
                app:elevation="4dp"
                app:rippleColor="@null" />

            <!-- ======================================================
                 BANNER AD
                 ====================================================== -->
            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_gravity="center_horizontal"
                app:adSize="BANNER"
                app:adUnitId="ca-app-pub-3940256099942544/6300978111" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>