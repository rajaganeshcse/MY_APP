<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_hit_rewardz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hit_rewardz_gradient">

        <!-- TOP-RIGHT CORNER GLOW ACCENT -->
        <View
            android:id="@+id/glowCircleHitz"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|end"
            android:alpha="0.20"
            android:background="@drawable/bg_wallet_glow_circle"
            android:translationX="25dp"
            android:translationY="-25dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- RIBBON BADGE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@drawable/bg_hitz_ribbon_gold"
                android:gravity="center"
                android:text="⚡ HIGH PAYOUT WEEKLY OFFER ⚡"
                android:textColor="#0F172A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_bonus_icon">

                    <ImageView
                        android:id="@+id/imgRewardIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lightning"
                        app:tint="#FFD700"
                        android:contentDescription="Hit Rewardz" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/txtRewardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hit Rewardz ⚡"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRewardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="High payout long ad tasks • Resets Monday"
                        android:textColor="#E9D5FF"
                        android:textSize="11.5sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/imgRewardArrow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_back_dark"
                    android:padding="6dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#FFFFFF"
                    android:contentDescription="Open" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>