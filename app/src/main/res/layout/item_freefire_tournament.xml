<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/black"
    android:backgroundTint="@color/black"
    android:outlineSpotShadowColor="@color/black"
    android:outlineAmbientShadowColor="@color/black"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:background="@color/white"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ================= TOP ROW ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">


            <!-- LEFT : WIN COIN -->
            <TextView
                android:id="@+id/txtPrize"
                android:layout_width="195dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:text="Win 500 Coins"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- RIGHT : TIME / DATE / PRIZE -->

            <ImageView
                android:id="@+id/imgCoin"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_coin" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8:30 PM"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Starts in 00:00:00"
                    android:textColor="#D32F2F"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtFirstPrize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="1st Prize 5000 🪙"
                    android:textColor="#2E7D32"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SLOTS ================= -->
        <TextView
            android:id="@+id/txtSlots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Slots Left : 26/100"
            android:textColor="#555"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressSlots"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#E0E0E0"
            android:max="100"
            android:progress="62"
            android:progressTint="#009688" />

        <!-- ================= GAME ID / PASSWORD ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gameid"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_yellow_outline"
                android:gravity="center"
                android:text="00000000"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gamePassword"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_outline_button"
                android:gravity="center"
                android:text="0000000000"
                android:textColor="@color/black"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================= ACTION BUTTONS ================= -->
        <!-- ================= ACTION BUTTONS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWinners"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Check Winners"
                android:textAllCaps="false"
                android:textColor="#6A1BFF"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="10dp"
                app:strokeColor="#6A1BFF"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoin"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Join (10 Tickets)"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#6A1BFF"
                app:cornerRadius="10dp" />
        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>
